{
  "name": "tinytales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "spec:check": "python3 scripts/check-specs.py",
    "mac:build": "node scripts/macos.mjs build",
    "mac:install": "node scripts/macos.mjs install",
    "mac:test": "node scripts/macos.mjs test",
    "mac:live": "node scripts/macos.mjs live",
    "mac:test:tts": "node scripts/macos.mjs tts-test",
    "mac:test:phone": "node scripts/macos.mjs phone-test",
    "mac:live:phone": "node scripts/macos.mjs phone-live",
    "mac:live:greeting": "node scripts/macos.mjs greeting-live",
    "mac:live:story": "node scripts/macos.mjs story-live",
    "mac:live:experience": "node scripts/macos.mjs experience-live",
    "dev": "node --use-env-proxy --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --use-env-proxy --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx scripts/check-ui.ts",
    "assets": "tsx scripts/build-assets.ts",
    "smoke:live": "node --use-env-proxy --env-file-if-exists=.env.local --import tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "1.71.0",
    "openai": "7.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "playwright-core": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
